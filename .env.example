# Copy to .env.local for local overrides. Do not commit secrets.
# Production: set these in Vercel Project → Settings → Environment Variables, then redeploy.
# Leave unset in local/dev to disable the gate (a banner will remind you).
# Never prefix these with NEXT_PUBLIC_ — they must stay server-only.
RESONANCE_APP_PASSWORD=

# Optional hub-only write key for curl / Monday Agentic. If unset, the site password works as Bearer.
RESONANCE_SYNC_SECRET=

# Production: created automatically when you add a Vercel Blob store (Storage → Blob → connect project).
# Local/dev: leave unset. The app writes .data/decisions.json instead.
# BLOB_READ_WRITE_TOKEN=

# Optional override for the local file store (tests / custom path).
# RESONANCE_DECISIONS_FILE=.data/decisions.json

# Hedera Testnet attestation (Phase 0.5). Server-only. Never NEXT_PUBLIC_*.
# Never paste HEDERA_OPERATOR_KEY into chat, Grok, or the repo.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.10506907
# Required for a live submit. DER or hex private key from the Testnet portal.
# HEDERA_OPERATOR_KEY=
# Optional. First successful Attest creates a topic if this is unset — then
# copy the returned 0.0.x id here and redeploy.
# HEDERA_TOPIC_ID=

