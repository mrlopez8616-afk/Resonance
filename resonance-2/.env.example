# Copy to .env.local for local overrides. Do not commit secrets.
# Production (Vercel project resonance3, Root Directory resonance-2):
# Settings → Environment Variables, then redeploy.
# Never prefix these with NEXT_PUBLIC_ — they must stay server-only.

# Hub / Robinhood Ops Bearer token for POST /api/fills.
# Local/dev: leave unset so POST is open. Production: set this.
RESONANCE_SYNC_SECRET=

# Read-only floor probe. GET /api/health/full requires
# Authorization: Bearer <this value>. It is not the sync secret.
# The route rejects a bearer that matches RESONANCE_SYNC_SECRET,
# so the two values must differ. Unset fails closed. No write route.
# RESONANCE_HEALTH_TOKEN=

# Production: created automatically when you add a Vercel Blob store
# (Storage → Blob → connect resonance3). Local/dev: leave unset.
# The app writes .data/fills.json instead.
# BLOB_READ_WRITE_TOKEN=

# Optional override for the local file store (tests / custom path).
# RESONANCE_FILLS_FILE=.data/fills.json

# Calendar uses the same Blob token and the same Bearer secret as fills.
# It writes a sibling object: resonance-2/calendar.json
# Local/dev file (optional override):
# RESONANCE_CALENDAR_FILE=.data/calendar.json
# GitHub Actions build lane: add the same RESONANCE_SYNC_SECRET value as a
# repository secret (Settings → Secrets and variables → Actions). Do not
# create a second secret name and do not put it in client code.

# Pooled Neon URL. The Vercel Marketplace Neon integration injects this.
# The app reads this variable only. Leave it unset to keep Blob / local files.
# DATABASE_URL=

# Coinbase portfolio read for the SUI node. Server only. Leave both unset
# and the node keeps the last stored SUI quantity, or the sleeve print.
# COINBASE_API_KEY_NAME is the CDP key name: organizations/{org_id}/apiKeys/{key_id}
# COINBASE_API_KEY_SECRET is the EC private key (PEM) or the base64 Ed25519 secret.
# A PEM may use \n for newlines. Never prefix either name with NEXT_PUBLIC_.
# COINBASE_API_KEY_NAME=
# COINBASE_API_KEY_SECRET=
