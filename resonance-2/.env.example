# Copy to .env.local for local overrides. Do not commit secrets.
# Production (Vercel project resonance3, Root Directory resonance-2):
# Settings → Environment Variables, then redeploy.
# Never prefix these with NEXT_PUBLIC_ — they must stay server-only.

# Hub / Robinhood Ops Bearer token for POST /api/fills.
# Local/dev: leave unset so POST is open. Production: set this.
RESONANCE_SYNC_SECRET=

# Production: created automatically when you add a Vercel Blob store
# (Storage → Blob → connect resonance3). Local/dev: leave unset.
# The app writes .data/fills.json instead.
# BLOB_READ_WRITE_TOKEN=

# Optional override for the local file store (tests / custom path).
# RESONANCE_FILLS_FILE=.data/fills.json

# Calendar uses the same Blob token and the same Bearer secret as fills.
# It writes a sibling object: resonance-2/calendar.json
# Local/dev file (optional override):
# RESONANCE_CALENDAR_FILE=.data/calendar.json
